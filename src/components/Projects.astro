    class: "bg-[#003159] text-white",
    icon: React,
  },
  EXPRESS: {
    name: "Express.js",
    class: "bg-black text-white",
    icon: Express,
  },
  FIREBASE: {
    name: "Firestore",
    class: "bg-black text-white",
