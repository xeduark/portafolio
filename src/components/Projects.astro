    github: "https://github.com/xeduark/EyA_SAS.git",
    image:
      "https://res.cloudinary.com/decmvewpj/image/upload/v1778554212/Captura_de_pantalla_2026-05-11_214908_eavggc.png",
    tags: [TAGS.HTML, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },
