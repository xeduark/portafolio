  },
  {
    title: "Fresh Food",
    description:
      "Dashboard para gestionar recetas vegetarianas y no vegetarianas con imágenes almacenadas en Google Storage.",
    github2: "https://github.com/xeduark/recetixBackend",
    github: "https://github.com/xeduark/recetixFrontend.git",
    image:
      "https://res.cloudinary.com/decmvewpj/image/upload/v1778560107/Captura_de_pantalla_2026-05-11_232603_x9lla9.png",
    tags: [TAGS.EXPRESS, TAGS.REACT, TAGS.FIREBASE, TAGS.CSS],
  },
  {
    title: "Asistify - Mobile",
    description:
      "Es una aplicación que permite al administrador gestionar y monitorear a los empleados en su versión móvil.",
    github:
      "https://github.com/xeduark/panel-control-asistencia-empleados-movil",
    image:
      "https://res.cloudinary.com/decmvewpj/image/upload/v1778553887/Captura_de_pantalla_2026-05-11_214411_bwq5lh.png",
    tags: [TAGS.FIREBASE, TAGS.JAVA],
  },
  {
    title: "My Nómina - Mobile",
    description:
      "Es una aplicación para calcular la nómina propia y de tus empleados, liquidaciones y gestionar gastos, en su versión móvil.",
    github: "https://github.com/xeduark/My-Nomina-movil",
    image:
      "https://res.cloudinary.com/decmvewpj/image/upload/v1778559673/Captura_de_pantalla_2026-05-11_231841_e4rlnu.png",
    tags: [TAGS.FIREBASE, TAGS.JAVA],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(
      ({ image, title, description, tags, link, github, github2 }) => (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
          <div class="w-full md:w-1/2">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <img
                alt="Recién llegado vs 5 años en Nueva Zelanda"
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg">
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {title}
            </h3>
            <div class="flex flex-wrap mt-2">
              <ul class="flex flex-row mb-2 gap-x-2">
                {tags.map((tag) => (
                  <li>
                    <span
                      class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                    >
                      <tag.icon class="size-4" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-2 text-gray-700 dark:text-gray-400">
                {description}
              </div>
              <footer class="flex items-end justify-start mt-4 gap-x-4">
                {github2 && (
                  <LinkButton href={github2}>
                    <GitHub2 class="size-6" />
                    Back-End
                  </LinkButton>
                )}
                {github && (
                  <LinkButton href={github}>
                    <GitHub class="size-6" />
                    Front-End
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <Link class="size-4" />
                    Preview
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>
      ),
    )
  }
</div>
